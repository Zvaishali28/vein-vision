# =================================================================
# VeinVision .gitignore
# Tailored for Next.js 16 + React 19 + TypeScript + FastAPI + PyTorch/YOLO
# =================================================================

# -----------------------------------------------------------------
# Environment Variables & Secrets (CRITICAL)
# -----------------------------------------------------------------
.env
.env*.local
.env.development
.env.test
.env.production
backend/.env
backend/.env.*
*.env
*.env.*
!.env.example
!backend/.env.example

# -----------------------------------------------------------------
# Node.js & Next.js Build Outputs
# -----------------------------------------------------------------
node_modules/
.next/
out/
build/
dist/
.vercel/
.turbo/
*.tsbuildinfo
next-env.d.ts

# Yarn / npm / pnpm logs & debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.pnp
.pnp.js

# -----------------------------------------------------------------
# Python & Virtual Environments
# -----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd

# Virtual Environments
venv/
.venv/
env/
ENV/
backend/venv/
backend/.venv/
**/venv/
**/.venv/

# Python packaging & distribution
.Python
develop-eggs/
downloads/
eggs/
.eggs/
parts/
var/
sdist/
*.egg-info/
.installed.cfg
*.egg

# -----------------------------------------------------------------
# Machine Learning Weights, Checkpoints & Datasets (>50MB / Binary)
# -----------------------------------------------------------------
# PyTorch, YOLO, Keras/TF, Pickle, and general weights
*.pth
*.pt
*.onnx
*.h5
*.hdf5
*.pkl
*.joblib
*.weights
*.bin
*.safetensors
*.ckpt

# Specific large files in workspace
backend/simple_varicose_model.pth
backend/yolov8n.pt
backend/*_model.pth
backend/checkpoint_epoch_*.pth
runs/
wandb/

# Datasets and training images (downloaded or synthetic large sets)
dataset/
dataset_backup/
models/
Varicose-Disease-*/
**/Varicose-Disease-*/

# -----------------------------------------------------------------
# Databases & Local Storage
# -----------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
backend/*.db
backend/*.sqlite3

# -----------------------------------------------------------------
# Runtime Uploads & Generated Reports
# -----------------------------------------------------------------
uploads/*
!uploads/.gitkeep
backend/uploads/*
!backend/uploads/.gitkeep
reports/*
!reports/.gitkeep
backend/reports/*
!backend/reports/.gitkeep

# Evaluation run artifacts
backend/test_download.pdf
backend/performance_results_*.json
backend/performance_summary_*.csv
backend/performance_analysis_*.png

# -----------------------------------------------------------------
# IDEs, Editors & OS Files
# -----------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# -----------------------------------------------------------------
# Testing & Coverage
# -----------------------------------------------------------------
/coverage
.nyc_output
.pytest_cache/
