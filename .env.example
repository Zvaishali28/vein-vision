# =================================================================
# VeinVision Environment Configuration Template
# Copy this file to .env (and .env.local for Next.js frontend)
# and populate with your own keys before running the application.
# =================================================================

# Backend Server Configuration
ENVIRONMENT=development
PORT=8000
FRONTEND_URL=http://localhost:3001
DEBUG=true

# Database Configuration
# Local SQLite default:
DATABASE_URL=sqlite:///./varicose_vein_app.db
# PostgreSQL / Supabase example:
# DATABASE_URL=postgresql://postgres:<password>@<db-host>:5432/<db-name>

# Roboflow API Configuration (for Varicose Vein Object Detection)
RF_API_KEY=your_roboflow_api_key_here
RF_MODEL_ID=varicose-disease-dp898
RF_VERSION=1

# Supabase (Optional Cloud Database & Auth)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# OpenAI API Key (Optional, fallback chatbot)
OPENAI_API_KEY=your_openai_api_key_here

# Redis Configuration (Optional - for response caching & rate limiting)
REDIS_URL=redis://localhost:6379

# Frontend Public Configuration (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
