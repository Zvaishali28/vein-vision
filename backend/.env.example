# =================================================================
# VeinVision Backend Environment Configuration Template
# Copy this file to backend/.env and populate with your own values.
# =================================================================

ENVIRONMENT=development
PORT=8000
FRONTEND_URL=http://localhost:3001
DEBUG=true

# Database Configuration (SQLite default for local dev)
DATABASE_URL=sqlite:///./varicose_vein_app.db
# PostgreSQL / Supabase example:
# DATABASE_URL=postgresql://postgres:<password>@<db-host>:5432/<db-name>

# Roboflow API (Object Detection)
RF_API_KEY=your_roboflow_api_key_here
RF_MODEL_ID=varicose-disease-dp898
RF_VERSION=1

# Supabase (Optional cloud database)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# OpenAI (Optional)
OPENAI_API_KEY=your_openai_api_key_here

# Redis (Caching & Rate Limiting)
REDIS_URL=redis://localhost:6379

